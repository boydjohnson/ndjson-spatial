use crate::parser::ast::{BinaryOp, CompareOp, Expr, Num, Term, Value};
use crate::parser::{negate, negate_num, unescape};
use yajlish_ndjson::Selector as JsonSelector;
use lalrpop_util::ParseError;
use ordered_float::OrderedFloat;

grammar;

// Numeric literals are unsigned; a leading `-` is unary minus (see `Unary`),
// so `3-5` lexes as `3`, `-`, `5`.
pub Float: f64 = r"[0-9]+\.[0-9]+([eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+" =>? {
    <>.parse::<f64>()
        .map_err(|_| ParseError::User {
            error: "f64 failed to parse"
        })
};

pub PosInt: u64 = r"[0-9]+" =>? {
    <>.parse::<u64>()
        .map_err(|_| ParseError::User {
            error: "u64 failed to parse"
        })
};

// A negative integer literal on its own (not reachable from `Expr`, where
// `-` is unary minus).
pub Int: i64 = "-" <p:PosInt> =>? match negate_num(Num::PosInt(p)) {
    Num::Int(i) => Ok(i),
    _ => Err(ParseError::User { error: "i64 failed to parse" }),
};

UnsignedNum: Num = {
    <f:Float> => Num::Float(OrderedFloat(f)),
    <p:PosInt> => Num::PosInt(p),
};

// A possibly-signed numeric literal on its own (not reachable from `Expr`).
pub Num: Num = {
    UnsignedNum,
    "-" <n:UnsignedNum> =>? match n {
        Num::PosInt(p) if p > 1 << 63 => Err(ParseError::User { error: "i64 failed to parse" }),
        n => Ok(negate_num(n)),
    },
};

// Keywords are literal tokens, which the lexer prefers over the
// `FunctionName` regex when both match the same text.
Bool: bool = {
    "true" => true,
    "false" => false,
};

// Double-quoted with backslash escapes; non-greedy so `"a" + "b"` is two
// strings.
StringP: String = <s:r#""([^"\\]|\\.)*""#> => unescape(&s[1..s.len() - 1]);

Null = {
    "null",
    "Null",
};

pub ValueToken: Value = {
    <n: UnsignedNum> => Value::Num(n),
    <s: StringP> => Value::String(s),
    <b: Bool> => Value::Bool(b),
    <Null> => Value::Null,
}

// `.name` (letters, digits, `_`) or `."any key"` for keys with other
// characters.
pub IdentifierToken: JsonSelector = {
    r"\.[A-Za-z0-9_]+" => JsonSelector::Identifier(Into::into(&<>[1..])),
    <s:r#"\."([^"\\]|\\.)*""#> => JsonSelector::Identifier(unescape(&s[2..s.len() - 1])),
    <k:BracketKey> => JsonSelector::Identifier(k),
};

// `["key"]`, one token.
BracketKey: String = <s:r#"\["([^"\\]|\\.)*"\]"#> => unescape(&s[2..s.len() - 2]);

pub ArrayToken: JsonSelector = {
    r"\[[0-9]+\]" =>? <>.trim_end_matches(']')
        .trim_start_matches('[')
        .parse::<usize>()
        .map_err(|_| ParseError::User {
        error: "Index too big",
    }).map(JsonSelector::Index)
}

EitherToken: JsonSelector = {
    <i:IdentifierToken> => i,
    <a:ArrayToken> => a,
}

pub Selector: Vec<JsonSelector> = {
    "d" <r: EitherToken *> => {
        r
    },
}

pub Term: Box<Expr> = {
    <n:ValueToken> => Box::new(Expr::Term(Term::Value(n))),
    <s:Selector> => Box::new(Expr::Term(Term::Selector(s))),
    "(" <e:Expr> ")" => e,
    <name:FunctionName> "(" <args:Comma<Expr>> ")" => {
        Box::new(Expr::Call(name, args.into_iter().map(|a| *a).collect()))
    },
}

FunctionName: String = r"[A-Za-z_][A-Za-z0-9_]*" => <>.to_string();

// Zero or more `T`s separated by commas.
Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

ExprMac<NextTier, Op>: Box<Expr> = {
    NextTier,
    <e:ExprMac<NextTier, Op>> <o:Op> <n:NextTier> => Box::new(Expr::Op(e, o, n)),
}

// Precedence, loosest first: `or`, `and`, `not`, comparisons / `is null` /
// `in`, `+ -`, `* /`, unary `-`, `**`.
pub Expr: Box<Expr> = {
    OrExpr,
};

OrExpr: Box<Expr> = {
    AndExpr,
    <l:OrExpr> "or" <r:AndExpr> => Box::new(Expr::Or(l, r)),
};

AndExpr: Box<Expr> = {
    NotExpr,
    <l:AndExpr> "and" <r:NotExpr> => Box::new(Expr::And(l, r)),
};

NotExpr: Box<Expr> = {
    CompareExpr,
    "not" <e:NotExpr> => Box::new(Expr::Not(e)),
};

// Non-associative: `a < b < c` doesn't parse.
CompareExpr: Box<Expr> = {
    Sum,
    <l:Sum> <o:CompareOp> <r:Sum> => Box::new(Expr::Compare(l, o, r)),
    <e:Sum> "is" Null => Box::new(Expr::IsNull { expr: e, negated: false }),
    <e:Sum> "is" "not" Null => Box::new(Expr::IsNull { expr: e, negated: true }),
    <e:Sum> "in" <list:InList> => Box::new(Expr::In { expr: e, list, negated: false }),
    <e:Sum> "not" "in" <list:InList> => Box::new(Expr::In { expr: e, list, negated: true }),
};

CompareOp: CompareOp = {
    "==" => CompareOp::Eq,
    "!=" => CompareOp::Ne,
    "<" => CompareOp::Lt,
    "<=" => CompareOp::Le,
    ">" => CompareOp::Gt,
    ">=" => CompareOp::Ge,
};

// `[lit, ...]`. The lexer reads a one-element `[3]` or `["a"]` as an
// index/key token, so those are accepted here too.
InList: Vec<Value> = {
    "[" <Comma<ListLiteral>> "]",
    <k:BracketKey> => vec![Value::String(k)],
    <a:ArrayToken> => match a {
        JsonSelector::Index(i) => vec![Value::Num(Num::PosInt(i as u64))],
        JsonSelector::Identifier(k) => vec![Value::String(k)],
    },
};

ListLiteral: Value = {
    ValueToken,
    "-" <n:UnsignedNum> => Value::Num(negate_num(n)),
};

// Arithmetic.
Sum: Box<Expr> = {
    ExprMac<Tier2, Tier1Op>,
};

Tier1Op: BinaryOp = {
   "+" => BinaryOp::Add,
   "-" => BinaryOp::Sub,
};

Tier2: Box<Expr> = {
    ExprMac<Unary, Tier2Op>,
};

Tier2Op: BinaryOp = {
    "*" => BinaryOp::Mul,
    "/" => BinaryOp::Div,
};

// Unary minus binds looser than `**`, as in Python: `-2 ** 2 == -4`.
// Negating a numeric literal folds into the literal.
Unary: Box<Expr> = {
    Tier3,
    "-" <u:Unary> => negate(u),
};

Tier3Op: BinaryOp = {
    "**" => BinaryOp::Pow,
};

Tier3: Box<Expr> = {
    Term,
    <s:Tier3> <o:Tier3Op> <t:Term> => Box::new(Expr::Op(s, o, t)),
};
